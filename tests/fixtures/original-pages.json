n\": \"1.0.2\",\n        \"applicationCategory\": \"UtilitiesApplication\",\n        \"operatingSystem\": \"Windows 10, Windows 11\",\n        \"description\": \"Board-independent CPU and memory tuning for Intel LGA1700 and AMD Ryzen Zen 2–5.\",\n        \"url\": \"https://mateopctech.com/roch-tools\",\n        \"downloadUrl\": \"https://github.com/RochStudio/Roch-CPU/releases\",\n        \"license\": \"https://www.gnu.org/licenses/gpl-3.0.html\",\n        \"author\": {\"@type\": \"Person\", \"name\": \"Mateo\", \"url\": \"https://mateopctech.com/\"},\n        \"offers\": {\"@type\": \"Offer\", \"price\": \"0\", \"priceCurrency\": \"USD\"}\n      },\n      {\n        \"@type\": \"SoftwareApplication\",\n        \"name\": \"Roch GPU\",\n        \"softwareVersion\": \"1.0.4\",\n        \"applicationCategory\": \"UtilitiesApplication\",\n        \"operatingSystem\": \"Windows 10, Windows 11\",\n        \"description\": \"Afterburner-style GPU tuning for NVIDIA and AMD from one executable.\",\n        \"url\": \"https://mateopctech.com/roch-tools\",\n        \"downloadUrl\": \"https://github.com/RochStudio/Roch-GPU/releases/download/v1.0.4/RochGPU.exe\",\n        \"license\": \"https://www.gnu.org/licenses/gpl-3.0.html\",\n        \"author\": {\"@type\": \"Person\", \"name\": \"Mateo\", \"url\": \"https://mateopctech.com/\"},\n        \"offers\": {\"@type\": \"Offer\", \"price\": \"0\", \"priceCurrency\": \"USD\"}\n      },\n      {\n        \"@type\": \"SoftwareApplication\",\n        \"name\": \"Roch NVRAM\",\n        \"softwareVersion\": \"1.0.1\",\n        \"applicationCategory\": \"UtilitiesApplication\",\n        \"operatingSystem\": \"Windows 10, Windows 11\",\n        \"description\": \"AMI SCEWIN NVRAM editor with backup, preflight checks and verified import.\",\n        \"url\": \"https://mateopctech.com/roch-tools\",\n        \"downloadUrl\": \"https://github.com/RochStudio/Roch-NVRAM/releases\",\n        \"license\": \"https://www.gnu.org/licenses/gpl-3.0.html\",\n        \"author\": {\"@type\": \"Person\", \"name\": \"Mateo\", \"url\": \"https://mateopctech.com/\"},\n        \"offers\": {\"@type\": \"Offer\", \"price\": \"0\", \"priceCurrency\": \"USD\"}\n      },\n      {\n        \"@type\": \"SoftwareApplication\",\n        \"name\": \"Roch Stress Test\",\n        \"softwareVersion\": \"1.0.0\",\n        \"applicationCategory\": \"UtilitiesApplication\",\n        \"operatingSystem\": \"Windows 10, Windows 11\",\n        \"description\": \"One window for Prime95, y-cruncher, TestMem5, Linpack, OCCT and more, with live failure detection.\",\n        \"url\": \"https://mateopctech.com/roch-tools\",\n        \"license\": \"https://www.gnu.org/licenses/gpl-3.0.html\",\n        \"author\": {\"@type\": \"Person\", \"name\": \"Mateo\", \"url\": \"https://mateopctech.com/\"},\n        \"offers\": {\"@type\": \"Offer\", \"price\": \"0\", \"priceCurrency\": \"USD\"}\n      }\n    ]\n  }\n  </script>\n  <link rel=\"canonical\" href=\"https://mateopctech.com/roch-tools\">\n  <link rel=\"icon\" href=\"/favicon.svg\" type=\"image/svg+xml\">\n  <link rel=\"stylesheet\" href=\"/style.css\">\n</head>\n<body>\n\n<a class=\"skip-link\" href=\"#main\">Skip to content</a>\n\n<header>\n  <h1>Mateo <span>PC Tech</span></h1>\n  <nav>\n    <a href=\"/\">Home</a>\n    <a href=\"/youtube\">YouTube</a>\n    <a href=\"/roch-tools\" class=\"active\" aria-current=\"page\">Roch Tools</a>\n    <a href=\"/skool\">Skool</a>\n    <a href=\"/discord\">Discord</a>\n    <a href=\"/parts\">Parts</a>\n  </nav>\n</header>\n\n<main id=\"main\">\n  <h2>Roch Tools</h2>\n  <p>PC tools made by Roch Studio.</p>\n\n  <div class=\"card\">\n    <h3>Roch Viewer</h3>\n    <p>\n      Read-only memory-controller and timing viewer for Windows. Shows what the controller,\n      modules, board and CPU actually report &mdash; timings, training results and live sensors.\n      It changes no setting.\n    </p>\n    <ul>\n      <li><strong>Platforms</strong> &mdash; Intel LGA1700, LGA1851, and AMD AM5</li>\n      <li><strong>Shows</strong> &mdash; timings, skew, telemetry, and a searchable advanced list</li>\n      <li><strong>Needs</strong> &mdash; Windows 10/11 x64 as administrator, plus <code>inpoutx64.dll</code> beside the EXE</li>\n    </ul>\n    <p>Free and open source (GPL-3.0).</p>\n    <a class=\"btn\" href=\"https://github.com/RochStudio/Roch-Viewer/releases\" target=\"_blank\">Download 1.0.2</a>\n    <a class=\"btn grey\" href=\"https://github.com/RochStudio/Roch-Viewer\" target=\"_blank\">View on GitHub</a>\n  </div>\n\n  <div class=\"card\">\n    <h3>Roch CPU</h3>\n    <p>\n      Board-independent CPU and memory tuning for <strong>Intel LGA1700</strong> and\n      <strong>AMD Ryzen</strong> (Zen 2 to Zen 5): ratios, voltages, power limits, Curve Optimizer,\n      and per-DIMM DDR5 rails.\n    </p>\n    <p><strong>Warning:</strong> bad values can crash or damage hardware. Changes do not survive a reboot.</p>\n    <ul>\n      <li><strong>Intel</strong> &mdash; ratios, OC mailbox voltages, PL1/PL2, DDR5 VDD/VDDQ/VPP</li>\n      <li><strong>AMD</strong> &mdash; PPT/TDC/EDC, PBO scalar, Curve Optimizer, FMax, DDR5 rails</li>\n      <li><strong>Needs</strong> &mdash; Windows 10/11 x64 as administrator, .NET 8 (or self-contained build)</li>\n    </ul>\n    <p>Free and open source (GPL-3.0).</p>\n    <a class=\"btn\" href=\"https://github.com/RochStudio/Roch-CPU/releases\" target=\"_blank\">Download 1.0.2</a>\n    <a class=\"btn grey\" href=\"https://github.com/RochStudio/Roch-CPU\" target=\"_blank\">View on GitHub</a>\n  </div>\n\n  <div class=\"card\">\n    <h3>Roch GPU</h3>\n    <p>\n      Afterburner-style GPU tuning for NVIDIA and AMD from one executable: clocks, voltage,\n      power limit, fan control, V/F curve, monitoring and profiles. No kernel driver.\n    </p>\n    <p><strong>Warning:</strong> writing clocks and voltages can crash or damage hardware.</p>\n    <ul>\n      <li><strong>Controls</strong> &mdash; clocks, limits, voltage, fan curve, Extreme OC (off by default)</li>\n      <li><strong>Also</strong> &mdash; live monitor, five profiles, built-in CLI</li>\n      <li><strong>Needs</strong> &mdash; Windows; administrator for writes. Self-contained EXE</li>\n    </ul>\n    <p>Free and open source (GPL-3.0).</p>\n    <a class=\"btn\" href=\"https://github.com/RochStudio/Roch-GPU/releases/download/v1.0.4/RochGPU.exe\" target=\"_blank\">Download 1.0.4</a>\n    <a class=\"btn grey\" href=\"https://github.com/RochStudio/Roch-GPU\" target=\"_blank\">View on GitHub</a>\n  </div>\n\n  <div class=\"card\">\n    <h3>Roch NVRAM</h3>\n    <p>\n      AMI SCEWIN NVRAM editor for Windows. Queue setting changes, then write only after a\n      backup, preflight checks and value-by-value verification.\n    </p>\n    <ul>\n      <li><strong>Safe write path</strong> &mdash; backup, preflight, verified import</li>\n      <li><strong>Also</strong> &mdash; searchable NVRAM table, compare, offline dry-run</li>\n      <li><strong>Needs</strong> &mdash; Windows as administrator; Python/Qt bundled</li>\n    </ul>\n    <p>Free and open source (GPL-3.0).</p>\n    <a class=\"btn\" href=\"https://github.com/RochStudio/Roch-NVRAM/releases\" target=\"_blank\">Download 1.0.1</a>\n    <a class=\"btn grey\" href=\"https://github.com/RochStudio/Roch-NVRAM\" target=\"_blank\">View on GitHub</a>\n  </div>\n\n  <div class=\"card\">\n    <h3>Roch Stress Test</h3>\n    <p>\n      One window for Prime95, y-cruncher, TestMem5, RAM Test Pro, Linpack, OCCT, Cinebench,\n      memtest_vulkan and 3DMark 11 &mdash; with presets, time limits and live failure detection.\n    </p>\n    <p><strong>Warning:</strong> these tests push hardware hard. Watch temps; do not leave a first run unattended.</p>\n    <ul>\n      <li><strong>Quick Start</strong> &mdash; one test at a time from tool cards</li>\n      <li><strong>Failure detection</strong> &mdash; watches logs/console; saves failed-run transcripts</li>\n      <li><strong>Needs</strong> &mdash; Windows as administrator; third-party tools beside the EXE</li>\n    </ul>\n    <p>Free and open source.</p>\n    <a class=\"btn grey\" href=\"https://github.com/RochStudio/Roch-StressTest\" target=\"_blank\">View on GitHub</a>\n  </div>\n\n  <a class=\"btn\" href=\"https://x.com/MateoPCTech\" target=\"_blank\">Follow for release news</a>\n</main>\n\n<footer>\n  <p>Mateo PC Tech &middot; <a href=\"https://www.youtube.com/@MateoPcTech\" target=\"_blank\">YouTube</a> &middot; <a href=\"https://www.youtube.com/@MateoBenchmarking\" target=\"_blank\">Benchmarking Channel</a> &middot; <a href=\"https://x.com/MateoPCTech\" target=\"_blank\">X (Twitter)</a> &middot; <a href=\"https://discord.gg/hPze8rTxqJ\" target=\"_blank\">Discord</a> &middot; <a href=\"https://github.com/RochStudio\" target=\"_blank\">GitHub</a> &middot; <a href=\"https://www.skool.com/mateo-tech-5956/about\" target=\"_blank\">Skool</a></p>\n</footer>\n\n</body>\n</html>\n",
  "skool": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Skool - Mateo PC Tech</title>\n  <meta name=\"description\" content=\"Tired of crashes and unstable overclocks? Learn safe CPU/RAM/GPU tuning for more FPS, cooler temps, and real stability — $20/month.\">\n  <meta property=\"og:title\" content=\"Skool - Mateo PC Tech\">\n  <meta property=\"og:description\" content=\"Tired of crashes and unstable overclocks? Learn safe CPU/RAM/GPU tuning for more FPS, cooler temps, and real stability — $20/month.\">\n  <meta property=\"og:type\" content=\"website\">\n  <meta property=\"og:url\" content=\"https://mateopctech.com/skool\">\n  <meta property=\"og:image\" content=\"https://yt3.googleusercontent.com/d6wcgiumeag_6_hJzusZ-VKq3-vsMR2aSPmc7PlqZ5YQZp1AxAwJO6lMt98lwipFhR4Zd15G=s900-c-k-c0x00ffffff-no-rj\">\n  <meta name=\"twitter:card\" content=\"summary\">\n  <meta name=\"twitter:site\" content=\"@MateoPCTech\">\n  <link rel=\"canonical\" href=\"https://mateopctech.com/skool\">\n  <link rel=\"icon\" href=\"/favicon.svg\" type=\"image/svg+xml\">\n  <link rel=\"stylesheet\" href=\"/style.css\">\n</head>\n<body>\n\n<a class=\"skip-link\" href=\"#main\">Skip to content</a>\n\n<header>\n  <h1>Mateo <span>PC Tech</span></h1>\n  <nav>\n    <a href=\"/\">Home</a>\n    <a href=\"/youtube\">YouTube</a>\n    <a href=\"/roch-tools\">Roch Tools</a>\n    <a href=\"/skool\" class=\"active\" aria-current=\"page\">Skool</a>\n    <a href=\"/discord\">Discord</a>\n    <a href=\"/parts\">Parts</a>\n  </nav>\n</header>\n\n<main id=\"main\">\n  <h2>Mateo PC Tech Community</h2>\n\n  <div class=\"card\">\n    <h3>More FPS, cooler temps, stable overclocks</h3>\n    <p>Tired of crashes, black screens, thermal limiters, and &quot;stable&quot; overclocks that fall apart mid-game?</p>\n    <p>For PC gamers who want more FPS, cooler temps, and a system that stays stable — without guessing
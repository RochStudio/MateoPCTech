  "parts": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Recommended Parts - Mateo PC Tech</title>\n  <meta name=\"description\" content=\"The CPUs, GPUs, RAM, and motherboards Mateo PC Tech recommends for gaming and overclocking.\">\n  <meta property=\"og:title\" content=\"Recommended Parts - Mateo PC Tech\">\n  <meta property=\"og:description\" content=\"The CPUs, GPUs, RAM, and motherboards Mateo PC Tech recommends for gaming and overclocking.\">\n  <meta property=\"og:type\" content=\"website\">\n  <meta property=\"og:url\" content=\"https://mateopctech.com/parts\">\n  <meta property=\"og:image\" content=\"https://yt3.googleusercontent.com/d6wcgiumeag_6_hJzusZ-VKq3-vsMR2aSPmc7PlqZ5YQZp1AxAwJO6lMt98lwipFhR4Zd15G=s900-c-k-c0x00ffffff-no-rj\">\n  <meta name=\"twitter:card\" content=\"summary\">\n  <meta name=\"twitter:site\" content=\"@MateoPCTech\">\n  <link rel=\"canonical\" href=\"https://mateopctech.com/parts\">\n  <link rel=\"icon\" href=\"/favicon.svg\" type=\"image/svg+xml\">\n  <link rel=\"stylesheet\" href=\"/style.css\">\n</head>\n<body>\n\n<a class=\"skip-link\" href=\"#main\">Skip to content</a>\n\n<header>\n  <h1>Mateo <span>PC Tech</span></h1>\n  <nav>\n    <a href=\"/\">Home</a>\n    <a href=\"/youtube\">YouTube</a>\n    <a href=\"/roch-tools\">Roch Tools</a>\n    <a href=\"/skool\">Skool</a>\n    <a href=\"/discord\">Discord</a>\n    <a href=\"/parts\" class=\"active\" aria-current=\"page\">Parts</a>\n  </nav>\n</header>\n\n<main id=\"main\">\n  <h2>Recommended Parts</h2>\n  <p>The parts I recommend for building and overclocking.</p>\n\n  <div class=\"card\">\n    <h3>CPU &mdash; Gaming</h3>\n    <p>Listed in order, best first.</p>\n\n    <p><strong>Intel</strong></p>\n    <ul>\n      <li>14900KS</li>\n      <li>14900K / 14900KF</li>\n      <li>13900KS</li>\n      <li>13900K / 13900KF</li>\n      <li>14700K / 14700KF</li>\n      <li>13700K / 13700KF</li>\n      <li>12900KS</li>\n      <li>12900K / 12900KF</li>\n      <li>12700K / 12700KF</li>\n    </ul>\n\n    <p><strong>AMD</strong></p>\n    <ul>\n      <li>9850X3D</li>\n      <li>9800X3D</li>\n      <li>7800X3D</li>\n    </ul>\n  </div>\n\n  <div class=\"card\">\n    <h3>RAM &mdash; Gaming</h3>\n\n    <p><strong>DDR5 &mdash; Intel</strong></p>\n    <ul>\n      <li>2x16 SK Hynix A-die 1R</li>\n    </ul>\n\n    <p><strong>DDR5 &mdash; AMD</strong></p>\n    <ul>\n      <li>2x16 SK Hynix A-die 1R</li>\n      <li>2x16 SK Hynix A-die 2R</li>\n      <li>2x32 SK Hynix A-die 2R</li>\n    </ul>\n\n    <p><strong>DDR4 &mdash; Intel</strong></p>\n    <ul>\n      <li>2x8 Samsung B-die</li>\n      <li>2x16 Samsung B-die</li>\n    </ul>\n  </div>\n\n  <div class=\"card\">\n    <h3>Motherboard &mdash; LGA 1700</h3>\n\n    <p><strong>DDR5 &mdash; 2 DIMM</strong></p>\n\n    <p>MSI</p>\n    <ul>\n      <li>Z690 Unify-X</li>\n      <li>Z690i Unify</li>\n      <li>Z790i Edge</li>\n      <li>Z790 MPower</li>\n    </ul>\n\n    <p>ASUS</p>\n    <ul>\n      <li>Z790 Apex</li>\n      <li>Z790 Apex Encore</li>\n    </ul>\n\n    <p>Gigabyte</p>\n    <ul>\n      <li>Z690 Tachyon</li>\n      <li>Z790 Tachyon</li>\n      <li>Z790 Tachyon-X</li>\n    </ul>\n\n    <p>ASRock</p>\n    <ul>\n      <li>Z790i Lightning</li>\n    </ul>\n\n    <p>EVGA</p>\n    <ul>\n      <li>Z690 KINGPIN</li>\n      <li>Z790 KINGPIN</li>\n    </ul>\n\n    <p><strong>DDR5 &mdash; 4 DIMM</strong></p>\n\n    <p>Gigabyte</p>\n    <ul>\n      <li>Z790 Master X</li>\n      <li>Z790 Pro X</li>\n      <li>Z790 Elite X</li>\n      <li>Z790 Elite X AX</li>\n    </ul>\n\n    <p><strong>DDR4</strong></p>\n\n    <p>MSI &mdash; any MSI DDR4 board will do the job</p>\n    <ul>\n      <li>PRO Z690-A DDR4 &mdash; the MSI pick</li>\n    </ul>\n\n    <p>ASUS</p>\n    <ul>\n      <li>Z690-A Strix D4</li>\n      <li>Z790-A Strix D4</li>\n    </ul>\n  </div>\n\n  <div class=\"card\">\n    <h3>GPU &mdash; Gaming</h3>\n\n  